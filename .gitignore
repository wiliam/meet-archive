# summit-db/ — каталог живой базы в новой раздельной раскладке Summit
# summit-archive/ — архив: база, папки встреч, индекс
/summit
/summit/
/summit-db
/summit-db/
/summit-archive
/summit-archive/

# Базы, бэкапы и состояние — на любом уровне вложенности
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.bak-*
archive-index.md
archive-state.json

# Состояние запущенного сервера: pid и логи
.run/

