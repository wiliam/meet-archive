# Конфигурация серверного экземпляра meet-archive.
#
# Реальные значения задаются в Dokploy (или подтягиваются из Infisical) и в
# репозиторий не попадают. Здесь только имена переменных и заглушки.

# server — публичный хаб: Basic Auth обязателен, /sync не регистрируется.
# local  — режим по умолчанию, ничего задавать не нужно.
MEET_ARCHIVE_ROLE=server

# Каталог с консолидированной базой и папками встреч (том контейнера).
SUMMIT_ARCHIVE_ROOT=/data

# Доступ в браузер. Без обоих значений сервер откажется стартовать.
ADMIN_USER=
ADMIN_PASSWORD=

# Токены устройств: "device-id:секрет" через запятую.
# Секрет на устройство: openssl rand -hex 32
INGEST_TOKENS=

# Предел размера одного бандла, байт (по умолчанию 32 МиБ).
INGEST_MAX_BYTES=33554432

# Домен, на который Traefik маршрутизирует сервис.
MEET_ARCHIVE_DOMAIN=
